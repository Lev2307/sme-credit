# Значения ниже рассчитаны на локальный запуск с синтетическими данными.
# Для любого другого окружения замените пароли и ключи.

# Порты, открытые наружу
FRONTEND_PORT=8080
BACKEND_PORT=8000
MOCKS_PORT=8090

# PostgreSQL (в Docker). Без Docker бэкенд работает на SQLite
POSTGRES_DB=sme_credit
POSTGRES_USER=sme_credit
POSTGRES_PASSWORD=sme_credit_local

# Фоновые задачи (Celery). Адреса базы, Redis и моков внутри Docker задаёт docker-compose
# 1 — фоновые задачи выполняются сразу, без Redis (локальный запуск). В Docker docker-compose ставит 0
CELERY_TASK_ALWAYS_EAGER=1 # локально
# Через сколько секунд после подписания «приходят» деньги
DISBURSEMENT_DELAY_SECONDS=5

# Django
DJANGO_SECRET_KEY=change-me-local-only-0123456789abcdefghijklmnopqrstuvwxyz
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Откуда можно войти в админку (проверка CSRF). При смене FRONTEND_PORT или домена поправьте и здесь
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# JWT
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=1
# 1 — refresh-cookie уходит только по HTTPS. Включите при публикации сайта за HTTPS
AUTH_COOKIE_SECURE=0

# Внешние сервисы (моки)
MOCKS_BASE_URL=http://localhost:8090 # локально
# Таймаут одного запроса и число попыток (между попытками пауза 0,5 → 1 → 2 с)
MOCKS_TIMEOUT_SECONDS=3
MOCKS_MAX_RETRIES=3
# Ключ, который бэкенд передаёт мокам в заголовке X-Api-Key
MOCKS_API_KEY=mocks-local-key
# Сколько секунд «думает» БКИ у компании с failure = "timeout". Больше MOCKS_TIMEOUT_SECONDS
MOCKS_BKI_DELAY_SECONDS=5

# Демо-данные: загружать тестовые учётки, продукты и требования к документам при старте
SEED_DEMO_DATA=1